<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orchpilot.workflow</groupId>
        <artifactId>workflow-engine-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>restapi-plugin</artifactId>
    <!-- Independently versioned from the parent: bumped to 1.0.1 for the new API glyph. -->
    <version>1.0.2</version>
    <name>REST API Workflow Plugin</name>
    <description>Sample node plugin: calls any HTTP endpoint and maps the response into variables</description>

    <properties>
        <plugin.id>restapi</plugin.id>
        <plugin.class>com.orchpilot.workflow.plugins.restapi.RestApiPlugin</plugin.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.orchpilot.workflow</groupId>
            <artifactId>workflow-plugin-sdk</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          Filtered so META-INF/workflow-plugin.json is generated from the same ${plugin.id}, ${plugin.class} and
          ${project.version} the JAR manifest entries use. Hand-maintaining the version in two places is how a
          plugin comes to declare 1.0.0 while being built as 1.1.0, which the registry would then record wrongly.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Workflow-Plugin-Class>${plugin.class}</Workflow-Plugin-Class>
                            <Workflow-Plugin-Id>${plugin.id}</Workflow-Plugin-Id>
                            <Workflow-Plugin-Version>${project.version}</Workflow-Plugin-Version>
                            <Workflow-Plugin-Api-Version>1</Workflow-Plugin-Api-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
