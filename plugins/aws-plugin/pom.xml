<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.orchpilot.workflow</groupId><artifactId>workflow-engine-parent</artifactId><version>1.0.0</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>aws-plugin</artifactId><version>1.0.0</version><name>AWS Workflow Plugin</name>
  <properties><plugin.id>aws</plugin.id><plugin.class>com.orchpilot.workflow.plugins.aws.AwsPlugin</plugin.class></properties>
  <dependencies>
    <dependency><groupId>com.orchpilot.workflow</groupId><artifactId>workflow-plugin-sdk</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources><resource><directory>src/main/resources</directory><filtering>true</filtering></resource></resources>
    <finalName>orchpilot-${project.artifactId}-${project.version}</finalName>
    <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><configuration><archive><manifestEntries>
      <Workflow-Plugin-Class>${plugin.class}</Workflow-Plugin-Class><Workflow-Plugin-Id>${plugin.id}</Workflow-Plugin-Id><Workflow-Plugin-Version>${project.version}</Workflow-Plugin-Version><Workflow-Plugin-Api-Version>1</Workflow-Plugin-Api-Version>
    </manifestEntries></archive></configuration></plugin></plugins>
  </build>
</project>
