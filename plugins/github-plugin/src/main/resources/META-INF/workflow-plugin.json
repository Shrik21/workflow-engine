  "dependencies": [],
  "permissions": {
    "network": ["api.github.com", "github.com"],
    "secrets": ["github."],
    "notes": "Calls the GitHub REST API only. Reads a Personal Access Token from a secret named with the github. prefix; the token is never placed in workflow configuration, output, logs, or exposed to the AI Agent. For GitHub Enterprise Server, add the enterprise host to the plugin's allowed hosts at install."
