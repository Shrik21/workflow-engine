{
  "pluginId": "${plugin.id}",
  "name": "Jira",
  "version": "${project.version}",
  "description": "Jira as an execution capability: issues, JQL search, transitions, comments, worklogs, sprints, boards, versions and components.",
  "vendor": "OrchPilot",
  "mainClass": "${plugin.class}",
  "sdkVersion": "1.0.0",
  "javaVersion": "17",
  "engineCompatibility": ">=1.0.0 <2.0.0",
  "pluginType": "NODE",
  "category": "PROJECT_MANAGEMENT",
  "supportsAI": true,
  "deployments": ["JIRA_CLOUD", "JIRA_SERVER"],
  "capabilities": [
    "jira.issue.create",
    "jira.issue.get",
    "jira.issue.update",
    "jira.issue.delete",
    "jira.issue.search",
    "jira.issue.assign",
    "jira.transition.execute",
    "jira.issue.clone",
    "jira.issue.changelog",
    "jira.transition.list",
    "jira.comment.create",
    "jira.comment.list",
    "jira.comment.update",
    "jira.comment.delete",
    "jira.worklog.create",
    "jira.worklog.list",
    "jira.attachment.add",
    "jira.attachment.list",
    "jira.project.list",
    "jira.project.get",
    "jira.component.list",
    "jira.version.list",
    "jira.user.search",
    "jira.user.current",
    "jira.issueType.list",
    "jira.priority.list",
    "jira.status.list",
    "jira.board.list",
    "jira.board.issues",
    "jira.sprint.list",
    "jira.sprint.get",
    "jira.sprint.create",
    "jira.sprint.start",
    "jira.sprint.close",
    "jira.sprint.moveIssues",
    "jira.version.create",
    "jira.version.release",
    "jira.component.create",
    "jira.component.delete"
  ],
  "notSupported": {
    "jira.attachment.binary": "Binary attachment upload and download cannot pass through the plugin HTTP client, which carries String bodies under a size ceiling. Text attachments (logs, reports, JSON) are supported."
  },
