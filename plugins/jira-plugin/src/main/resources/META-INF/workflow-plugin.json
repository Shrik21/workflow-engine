  "dependencies": [],
  "permissions": {
    "network": ["*.atlassian.net", "*.atlassian.com"],
    "secrets": ["jira."],
    "notes": "Reads Jira credentials from secrets named with the jira. prefix; a credential never enters workflow configuration, node output, logs, or the AI Agent. For Jira Server/Data Center, add the host to the allowed hosts at install time."
