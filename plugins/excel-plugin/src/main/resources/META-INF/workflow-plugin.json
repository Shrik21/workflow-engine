{
  "pluginId": "${plugin.id}",
  "name": "Excel Handler",
  "version": "${project.version}",
  "description": "Read, write, search, transform, validate, merge, split, compare and report on Excel workbooks from workflows and the AI Agent.",
  "vendor": "OrchPilot",
  "mainClass": "${plugin.class}",
  "sdkVersion": "1.0.0",
  "javaVersion": "17",
  "engineCompatibility": ">=1.0.0 <2.0.0",
  "pluginType": "NODE",
  "category": "FILE_PROCESSING",
  "supportsAI": true,
  "formats": ["xlsx", "xls", "xlsm"],
  "capabilities": [
    "excel.sheet.read",
    "excel.workbook.listSheets",
    "excel.sheet.metadata",
    "excel.cell.get",
    "excel.search",
    "excel.filter",
    "excel.sort",
    "excel.validate",
    "excel.transform",
    "excel.compare",
    "excel.report",
    "excel.create",
    "excel.sheet.write",
    "excel.row.add",
    "excel.row.update",
    "excel.cell.set",
    "excel.row.delete",
    "excel.sheet.create",
    "excel.sheet.rename",
    "excel.sheet.copy",
    "excel.sheet.delete",
    "excel.merge",
    "excel.split",
    "excel.toJson",
    "excel.fromJson",
    "excel.toCsv",
    "excel.fromCsv"
  ],
  "notSupported": {
    "excel.macro.execute": "Macros are never executed. A .xlsm opens as data only; the macro storage is never read, so there is no code path that could run VBA.",
    "excel.formula.arbitrary": "Formulas are read, not interpreted as code. Writing a formula is restricted to an allow-list of spreadsheet functions, so a generated workbook cannot carry WEBSERVICE, RTD or similar.",
    "excel.filesystem.path": "A filesystem path is never accepted. Workbooks are addressed by workflow file id and reached through the engine's execution-scoped file accessor.",
    "excel.overwrite": "An input file is never overwritten. Every operation that changes a workbook stores a new file, so the original stays readable and a retry starts from what it started from."
  },
  "nodes": [
    { "nodeType": "EXCEL_READ", "displayName": "Read Excel Sheet", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.sheet.read", "aiToolName": "excel_sheet_read" },
    { "nodeType": "EXCEL_READ_WORKBOOK", "displayName": "Read Excel Workbook", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.workbook.listSheets", "aiToolName": "excel_workbook_list_sheets" },
    { "nodeType": "EXCEL_SHEET_METADATA", "displayName": "Get Excel Sheet Metadata", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.sheet.metadata", "aiToolName": "excel_sheet_metadata" },
    { "nodeType": "EXCEL_GET_CELL", "displayName": "Get Excel Cell", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.cell.get", "aiToolName": "excel_cell_get" },
    { "nodeType": "EXCEL_SEARCH", "displayName": "Search Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.search", "aiToolName": "excel_search" },
    { "nodeType": "EXCEL_FILTER", "displayName": "Filter Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.filter", "aiToolName": "excel_filter" },
    { "nodeType": "EXCEL_SORT", "displayName": "Sort Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.sort", "aiToolName": "excel_sort" },
    { "nodeType": "EXCEL_VALIDATE", "displayName": "Validate Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.validate", "aiToolName": "excel_validate" },
    { "nodeType": "EXCEL_TRANSFORM", "displayName": "Transform Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "LOW", "capability": "excel.transform", "aiToolName": "excel_transform" },
    { "nodeType": "EXCEL_COMPARE", "displayName": "Compare Excel Files", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.compare", "aiToolName": "excel_compare" },
    { "nodeType": "EXCEL_GENERATE_REPORT", "displayName": "Generate Excel Report", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "LOW", "capability": "excel.report", "aiToolName": "excel_report" },
    { "nodeType": "EXCEL_CREATE", "displayName": "Create Excel File", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.create", "aiToolName": "excel_create" },
    { "nodeType": "EXCEL_WRITE", "displayName": "Write Excel Sheet", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.sheet.write", "aiToolName": "excel_sheet_write" },
    { "nodeType": "EXCEL_APPEND", "displayName": "Append Excel Rows", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.row.add", "aiToolName": "excel_row_add" },
    { "nodeType": "EXCEL_UPDATE", "displayName": "Update Excel Rows", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.row.update", "aiToolName": "excel_row_update" },
    { "nodeType": "EXCEL_SET_CELL", "displayName": "Set Excel Cell", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.cell.set", "aiToolName": "excel_cell_set" },
    { "nodeType": "EXCEL_DELETE_ROW", "displayName": "Delete Excel Rows", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": true, "riskLevel": "HIGH", "capability": "excel.row.delete", "aiToolName": "excel_row_delete" },
    { "nodeType": "EXCEL_CREATE_SHEET", "displayName": "Create Excel Sheet", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.sheet.create", "aiToolName": "excel_sheet_create" },
    { "nodeType": "EXCEL_RENAME_SHEET", "displayName": "Rename Excel Sheet", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.sheet.rename", "aiToolName": "excel_sheet_rename" },
    { "nodeType": "EXCEL_COPY_SHEET", "displayName": "Copy Excel Sheet", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.sheet.copy", "aiToolName": "excel_sheet_copy" },
    { "nodeType": "EXCEL_DELETE_SHEET", "displayName": "Delete Excel Sheet", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": true, "riskLevel": "HIGH", "capability": "excel.sheet.delete", "aiToolName": "excel_sheet_delete" },
    { "nodeType": "EXCEL_MERGE", "displayName": "Merge Excel Files", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.merge", "aiToolName": "excel_merge" },
    { "nodeType": "EXCEL_SPLIT", "displayName": "Split Excel File", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.split", "aiToolName": "excel_split" },
    { "nodeType": "EXCEL_TO_JSON", "displayName": "Excel To JSON", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "excel.toJson", "aiToolName": "excel_to_json" },
    { "nodeType": "EXCEL_JSON_TO_EXCEL", "displayName": "JSON To Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.fromJson", "aiToolName": "excel_from_json" },
    { "nodeType": "EXCEL_TO_CSV", "displayName": "Excel To CSV", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "LOW", "capability": "excel.toCsv", "aiToolName": "excel_to_csv" },
    { "nodeType": "EXCEL_CSV_TO_EXCEL", "displayName": "CSV To Excel", "category": "Excel", "icon": "table", "supportsAI": true, "destructive": false, "riskLevel": "MEDIUM", "capability": "excel.fromCsv", "aiToolName": "excel_from_csv" }
  ],
  "dependencies": [
    { "groupId": "org.apache.poi", "artifactId": "poi", "version": "5.2.2", "bundled": true, "reason": "Legacy .xls reading." },
    { "groupId": "org.apache.poi", "artifactId": "poi-ooxml", "version": "5.2.2", "bundled": true, "reason": ".xlsx reading and SXSSF streaming generation." }
  ],
  "permissions": {
    "network": [],
    "secrets": [],
    "workflowFiles": "read-write",
    "notes": "Needs no network access and no secrets. It reads and writes files attached to the workflow version being executed, through the engine's file accessor, which is bound to that workflow and cannot address another one."
  }
}
