    { "nodeType": "K8S_DELETE_MANIFEST", "displayName": "Delete Kubernetes Manifest Resource", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": true, "riskLevel": "HIGH", "capability": "kubernetes.manifest.delete", "aiToolName": "k8s_delete_manifest" }
  ],
  "dependencies": [
    { "groupId": "org.yaml", "artifactId": "snakeyaml", "version": "2.5", "bundled": true, "reason": "Kubernetes manifests are YAML; parsed with SafeConstructor, aliases disabled and a size limit." }
  ],
  "permissions": {
    "network": ["container.googleapis.com", "oauth2.googleapis.com", "*.gke.goog"],
    "secrets": ["gke."],
    "notes": "Reads a GCP service-account key from a secret named with the gke. prefix. The credential never enters workflow configuration, node output, workflow variables, logs, audit records, or the AI Agent's context. container.googleapis.com serves cluster management; *.gke.goog is the DNS-based cluster control plane endpoint, which is the only cluster endpoint whose certificate the engine's shared HTTP client can verify."
  }
}
