    { "nodeType": "K8S_DELETE_JOB", "displayName": "Delete Kubernetes Job", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": true, "riskLevel": "HIGH", "capability": "kubernetes.job.delete", "aiToolName": "k8s_delete_job" },
    { "nodeType": "K8S_LIST_CRONJOBS", "displayName": "List Kubernetes CronJobs", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "kubernetes.cronjob.list", "aiToolName": "k8s_list_cronjobs" },

    { "nodeType": "K8S_LIST_STATEFULSETS", "displayName": "List Kubernetes StatefulSets", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "kubernetes.statefulset.list", "aiToolName": "k8s_list_statefulsets" },
    { "nodeType": "K8S_SCALE_STATEFULSET", "displayName": "Scale Kubernetes StatefulSet", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": false, "riskLevel": "LOW", "capability": "kubernetes.statefulset.scale", "aiToolName": "k8s_scale_statefulset" },
    { "nodeType": "K8S_LIST_DAEMONSETS", "displayName": "List Kubernetes DaemonSets", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "kubernetes.daemonset.list", "aiToolName": "k8s_list_daemonsets" },
    { "nodeType": "K8S_LIST_INGRESSES", "displayName": "List Kubernetes Ingresses", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "kubernetes.ingress.list", "aiToolName": "k8s_list_ingresses" },
    { "nodeType": "K8S_LIST_HPAS", "displayName": "List Kubernetes Autoscalers", "category": "Kubernetes", "icon": "layers", "supportsAI": true, "destructive": false, "riskLevel": "READ_ONLY", "capability": "kubernetes.hpa.list", "aiToolName": "k8s_list_hpas" },
